### Change the following values if you want to customize the HTTP client settings for Muasamcong API
# MUASAMCONG_MAX_CONNECTIONS=2
# MUASAMCONG_MAX_KEEPALIVE_CONNECTIONS=1

# MUASAMCONG_CONNECT_TIMEOUT=20.0
# MUASAMCONG_READ_TIMEOUT=45.0

# MUASAMCONG_RETRY_ATTEMPTS=5
# MUASAMCONG_RETRY_BASE_DELAY=2.0
# MUASAMCONG_RETRY_MAX_DELAY=45.0